{
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/__/auth/:path*", "destination": "https://book-nerd.firebaseapp.com/__/auth/:path*" }
  ],
  "functions": {
    "api/search.ts": { "maxDuration": 60 },
    "api/refresh-series.ts": { "maxDuration": 60 },
    "api/check-news.ts": { "maxDuration": 60 },
    "api/scan-books.ts": { "maxDuration": 60 },
    "api/recommend.ts": { "maxDuration": 60 }
  }
}
